  const dateObj = new Date(d+'T00:00:00');
  const dayName = dateObj.toLocaleDateString('en',{weekday:'long'});
  const dateFormatted = dateObj.toLocaleDateString('en',{month:'long',day:'numeric',year:'numeric'});
  $('dmDate').textContent = dateFormatted;
  $('dmSub').textContent = `${dayName} · ${dt.length} trade${dt.length>1?'s':''} · ${dt[0].instrument||'NASDAQ'}`;

  // Stats for the day
  const dayPnl = dt.reduce((s,t)=>s+t.pnl,0);
  const wins = dt.filter(t=>t.pnl>0);
  const losses = dt.filter(t=>t.pnl<0);
  const bes = dt.filter(t=>t.pnl===0);
  const grossW = wins.reduce((s,t)=>s+t.pnl,0);
  const grossL = Math.abs(losses.reduce((s,t)=>s+t.pnl,0));
  const avgScore = dt.reduce((s,t)=>s+(+t.score||0),0)/dt.length;
  const pf = grossL>0 ? (grossW/grossL).toFixed(2) : grossW>0?'∞':'—';
  const sessions = [...new Set(dt.map(t=>t.session))].join(', ');

  // Summary strip
  const dayRetPct = accountSize > 0 ? (dayPnl / accountSize * 100) : null;
  $('dmStrip').innerHTML = `
    <div class="dss-card">
      <div class="dss-label">Day P&L</div>
      <div class="dss-val" style="color:${dayPnl>=0?'var(--green)':'var(--red)'}">${fmt(dayPnl)}</div>
      ${dayRetPct!==null?`<div style="font-size:10px;color:var(--muted);margin-top:3px">${dayRetPct>=0?'+':''}${dayRetPct.toFixed(2)}% of acct</div>`:''}
    </div>
    <div class="dss-card">
      <div class="dss-label">Trades</div>
      <div class="dss-val" style="color:var(--text)">${dt.length}</div>
    </div>
    <div class="dss-card">
      <div class="dss-label">Win / Loss</div>
      <div class="dss-val"><span style="color:var(--green)">${wins.length}</span><span style="color:var(--muted);font-size:14px"> / </span><span style="color:var(--red)">${losses.length}</span></div>
    </div>
    <div class="dss-card">
      <div class="dss-label">Profit Factor</div>
      <div class="dss-val" style="color:var(--gold)">${pf}</div>
    </div>
    <div class="dss-card">
      <div class="dss-label">Avg Score</div>
      <div class="dss-val" style="color:var(--accent2)">${avgScore.toFixed(1)}/5</div>
    </div>
  `;

  // P&L bar
  const total = grossW + grossL || 1;
  const winPct = (grossW/total*100).toFixed(1);
  const lossPct = (grossL/total*100).toFixed(1);
  $('dmBar').innerHTML = `<div class="dpb-win" style="width:${winPct}%"></div><div class="dpb-loss" style="width:${lossPct}%"></div>`;
  $('dmBarLegend').innerHTML = `
    <span><span class="dpbl-dot" style="background:var(--green)"></span>Gross Win: <strong style="color:var(--green)">${fmt(grossW)}</strong></span>
    <span><span class="dpbl-dot" style="background:var(--red)"></span>Gross Loss: <strong style="color:var(--red)">-${fmt(grossL)}</strong></span>
    ${bes.length?`<span><span class="dpbl-dot" style="background:var(--muted)"></span>BE: ${bes.length}</span>`:''}
    <span style="margin-left:auto;color:var(--muted)">Sessions: ${sessions}</span>
  `;

  // Trade count label
  $('dmTradeCount').textContent = `${dt.length} Trade${dt.length>1?'s':''} This Day`;

  // Individual trade cards
  $('dmTradeList').innerHTML = dt.map(t=>{
    const isWin = t.pnl>0; const isLoss = t.pnl<0; const isTrail = t.outcome==='Trailing stop';
    const cardCls = isWin?'win-card':(isLoss?'loss-card':(isTrail?'trail-card':'be-card'));
    const pnlCls = isWin?'pos':(isLoss?'neg':'zero');
    const dirColor = t.dir==='Long'?'var(--green)':'var(--red)';
    const outColor = t.outcome==='TP'?'var(--green)':(t.outcome==='SL'?'var(--red)':(t.outcome==='Trailing stop'?'var(--gold)':'var(--muted2)'));
    const score = parseInt(t.score)||0;
    const scorePips = Array.from({length:5},(_,i)=>`<div class="dtc-score-pip ${i<score?'filled':''}"></div>`).join('');
    const hasNotes = t.notes && t.notes.trim();
    return `<div class="day-trade-card ${cardCls}" onclick="openModal(${t.num})" style="cursor:pointer" title="Click to view full details">
      <div class="dtc-header">
        <span class="dtc-num">Trade #${t.num}</span>
        <span class="pill ${t.dir==='Long'?'long':'short'}" style="font-size:10px">${t.dir}</span>
        <span class="pill ${t.outcome==='TP'?'tp':(t.outcome==='SL'?'sl':(t.outcome==='Trailing stop'?'trail':'be'))}" style="font-size:10px">${t.outcome}</span>
        ${t.time?`<span style="font-size:11px;color:var(--muted2)">⏱ ${t.time}</span>`:''}
        <span style="font-size:11px;color:var(--muted2)">${t.session||''}</span>
        <span class="dtc-pnl ${pnlCls}">${fmt(t.pnl)}</span>
      </div>
      <div class="dtc-body">
        <div class="dtc-field">
          <span class="dtf-label">Instrument</span>
          <span class="dtf-val">${t.instrument||'—'}</span>
        </div>
        <div class="dtc-field">
          <span class="dtf-label">R:R Planned</span>
          <span class="dtf-val">${t.rr||'—'}</span>
        </div>
        <div class="dtc-field">
          <span class="dtf-label">Position Size</span>
          <span class="dtf-val">${t.size||'—'} lots</span>
        </div>
        <div class="dtc-field">
          <span class="dtf-label">Duration</span>
          <span class="dtf-val">${t.duration||'—'}</span>
        </div>
        <div class="dtc-field" style="grid-column:span 2">
          <span class="dtf-label">Trade Score</span>
          <div class="dtc-score-bar" style="margin-top:3px">${scorePips}<span style="font-size:11px;color:var(--muted2);margin-left:6px">${score}/5</span></div>
        </div>
        <div class="dtc-field" style="grid-column:span 2">
          <span class="dtf-label">Day of Week</span>
          <span class="dtf-val">${t.day||'—'}</span>
        </div>
      </div>
      ${hasNotes?`<div class="dtc-notes"><div class="dtc-notes-inner">📝 ${t.notes}</div></div>`:''}
    </div>`;
  }).join('');

  $('dayModal').classList.add('open');
}

/* ==================== ANALYTICS ==================== */
function renderAnalytics(){
  const m = computeMetrics();
  $('sGP').textContent = fmt(m.grossProfit);
  $('sGL').textContent = fmt(-m.grossLoss);
  $('sNet').textContent = fmt(m.netPnl);
  $('sNet').className = 'sr-val '+(m.netPnl>=0?'pnl-pos':'pnl-neg');
  $('sPF').textContent = m.pf.toFixed(2);
  $('sExp').textContent = fmt(m.expectancy);
  $('sSharpe').textContent = m.sharpe.toFixed(2);
  $('sWR').textContent = m.winRate.toFixed(1)+'%';
  $('sLR').textContent = (100-m.winRate).toFixed(1)+'%';
  $('sAW').textContent = fmt(m.avgWin);
  $('sAL').textContent = fmt(-m.avgLoss);
  $('sARR').textContent = '1:'+m.avgRR.toFixed(2);
  $('sLWL').textContent = `${fmt(m.best?.pnl||0)} / ${fmt(m.worst?.pnl||0)}`;
  $('sDD').textContent = fmt(-m.maxDD);
  $('sWS').textContent = m.winStreak;
  $('sLS').textContent = m.lossStreak;
  $('sRF').textContent = m.recoveryFactor.toFixed(2);
  $('sSD').textContent = fmt(m.sd);
  $('sKelly').textContent = m.kelly.toFixed(1)+'%';

  // Account-relative analytics rows
  const hasAcct = accountSize > 0;
  const show = el => { if($(el)) $(el).style.display = hasAcct?'':'none'; };
  show('aRowReturn'); show('aRowBalance'); show('aRowDD'); show('aRowRisk1'); show('aRowRisk2');
  if(hasAcct){
    const returnPct = m.netPnl / accountSize * 100;
    const balance = accountSize + m.netPnl;
    const ddPct = m.maxDD > 0 ? (m.maxDD / accountSize * 100) : 0;
    $('aReturn').textContent = (returnPct>=0?'+':'')+returnPct.toFixed(2)+'%';
    $('aReturn').style.color = returnPct>=0?'var(--green)':'var(--red)';
    $('aBalance').textContent = fmt(balance);
    $('aBalance').style.color = balance >= accountSize ? 'var(--green)' : 'var(--red)';
    $('sDDpct').textContent = '-'+ddPct.toFixed(2)+'%';
    $('aRisk1').textContent = fmt(accountSize*0.01);
    $('aRisk2').textContent = fmt(accountSize*0.02);
  }
  drawAnalyticsCharts();
}

function drawAnalyticsCharts(){
  const sorted = [...trades].sort((a,b)=>new Date(a.date)-new Date(b.date));
  // Drawdown
  destroyChart('dd');
  let cum=0,peak=0; const ddData=[];
  sorted.forEach(t=>{cum+=t.pnl;if(cum>peak)peak=cum;ddData.push(cum-peak);});
  if($('ddChart')){
    charts.dd = new Chart($('ddChart'),{
      type:'line',
      data:{labels:sorted.map(t=>t.date),datasets:[{label:'Drawdown',data:ddData,borderColor:'#ff4d6d',backgroundColor:'rgba(255,77,109,0.15)',fill:true,tension:.2,pointRadius:1}]},
      options:chartOpts
    });
  }
  // Histogram
  destroyChart('hist');
  const buckets = {};
  trades.forEach(t=>{const b = Math.floor(t.pnl/5)*5; buckets[b]=(buckets[b]||0)+1;});
  const keys = Object.keys(buckets).map(Number).sort((a,b)=>a-b);
  if($('histChart')){
    charts.hist = new Chart($('histChart'),{
      type:'bar',
      data:{labels:keys.map(k=>`$${k} to $${k+5}`),datasets:[{label:'Count',data:keys.map(k=>buckets[k]),backgroundColor:keys.map(k=>k>=0?'#10d98a':'#ff4d6d')}]},
      options:chartOpts
    });
  }
  // Score scatter
  destroyChart('score');
  if($('scoreChart')){
    charts.score = new Chart($('scoreChart'),{
      type:'scatter',
      data:{datasets:[{label:'Trade',data:trades.map(t=>({x:parseInt(t.score)||0,y:t.pnl})),backgroundColor:trades.map(t=>t.pnl>=0?'#10d98a':'#ff4d6d'),pointRadius:5}]},
      options:{...chartOpts,scales:{x:{title:{display:true,text:'Score',color:'#6b7280'},min:0,max:6,ticks:{color:'#6b7280'},grid:{color:'rgba(255,255,255,0.04)'}},y:{title:{display:true,text:'P&L',color:'#6b7280'},ticks:{color:'#6b7280'},grid:{color:'rgba(255,255,255,0.04)'}}}}
    });
  }
}

/* ==================== SESSIONS ==================== */
function renderSessions(){
  const sessions = ['NY am','NY pm','London','Asia'];
  const grid = sessions.map(s=>{
    const st = trades.filter(t=>t.session===s);
    const wins = st.filter(t=>t.pnl>0).length;
    const pnl = st.reduce((sum,t)=>sum+t.pnl,0);
    const wr = st.length?(wins/st.length*100):0;
    const cls = s==='NY am'?'ny-am':s==='NY pm'?'ny-pm':s==='London'?'london':'asia';
    return `<div class="session-card ${cls}">
      <div class="mc-label">${s.toUpperCase()}</div>
      <div class="mc-value ${pnl>=0?'pos':'neg'}" style="font-size:20px">${fmt(pnl)}</div>
      <div class="mc-sub">${st.length} trades · ${wr.toFixed(1)}% WR</div>
      <div class="risk-meter"><div class="risk-fill" style="width:${Math.min(wr,100)}%;background:linear-gradient(90deg,${pnl>=0?'var(--green)':'var(--red)'},var(--accent))"></div></div>
    </div>`;
  }).join('');
  $('sessionGrid').innerHTML = grid;

  destroyChart('sessWR');
  destroyChart('sessPnl');
  destroyChart('sessHeat');

  const wrData = sessions.map(s=>{
    const st = trades.filter(t=>t.session===s);
    return st.length?(st.filter(t=>t.pnl>0).length/st.length*100):0;
  });
  const pnlData = sessions.map(s=>trades.filter(t=>t.session===s).reduce((sum,t)=>sum+t.pnl,0));

  if($('sessWR')){
    charts.sessWR = new Chart($('sessWR'),{
      type:'bar',
      data:{labels:sessions,datasets:[{label:'Win Rate %',data:wrData,backgroundColor:'#6c63ff'}]},
      options:chartOpts
    });
  }
  if($('sessPnl')){
    charts.sessPnl = new Chart($('sessPnl'),{
      type:'bar',
      data:{labels:sessions,datasets:[{label:'P&L',data:pnlData,backgroundColor:pnlData.map(v=>v>=0?'#10d98a':'#ff4d6d')}]},
      options:chartOpts
    });
  }

  // Heatmap by day & session
  const days = ['Monday','Tuesday','Wednesday','Thursday','Friday'];
  const datasets = sessions.map((s,i)=>({
    label:s,
    data:days.map(d=>trades.filter(t=>t.session===s && t.day===d).length),
    backgroundColor:['#38bdf8','#f5c842','#6c63ff','#10d98a'][i]
  }));
  if($('sessHeat')){
    charts.sessHeat = new Chart($('sessHeat'),{
      type:'bar',
      data:{labels:days,datasets},
      options:{...chartOpts,scales:{x:{stacked:true,ticks:{color:'#6b7280'},grid:{color:'rgba(255,255,255,0.04)'}},y:{stacked:true,ticks:{color:'#6b7280'},grid:{color:'rgba(255,255,255,0.04)'}}}}
    });
  }
}

/* ==================== CALCULATOR ==================== */
function calcPosition(){
  const acc = +$('cAcc').value||0;
  const risk = +$('cRisk').value||0;
  const entry = +$('cEntry').value||0;
  const stop = +$('cStop').value||0;
  const tp = +$('cTP').value||0;
  const tickVal = +$('cTick').value||0;
  const tickSz = +$('cTickSz').value||0.25;
  const com = +$('cCom').value||0;
  const riskAmt = acc*risk/100;
  const stopTicks = Math.abs(entry-stop)/tickSz;
  const riskPerC = stopTicks*tickVal + com*2;
  const contracts = riskPerC>0 ? Math.floor(riskAmt/riskPerC*100)/100 : 0;
  const profitTicks = Math.abs(tp-entry)/tickSz;
  const profit = profitTicks*tickVal*contracts - com*2*contracts;
  const rr = riskAmt>0 ? profit/riskAmt : 0;
  $('rRiskAmt').textContent = `$${riskAmt.toFixed(2)}`;
  $('rStopT').textContent = stopTicks.toFixed(0);
  $('rRiskC').textContent = `$${riskPerC.toFixed(2)}`;
  $('rContracts').textContent = contracts.toFixed(2);
  $('rProfit').textContent = `$${profit.toFixed(2)}`;
  $('rRR').textContent = `1:${rr.toFixed(2)}`;
}

function calcGoal(){
  const start = +$('gStart').value||0;
  const goal = +$('gGoal').value||0;
  const wr = (+$('gWR').value||0)/100;
  const rr = +$('gRR').value||0;
  const risk = (+$('gRisk').value||0)/100;
  const tpd = +$('gTPD').value||1;
  const expR = wr*rr - (1-wr); // in R units
  const expDollar = expR * (start*risk);
  const edgePct = expR*risk*100;
  const trades = expDollar>0 && goal>start ? Math.ceil(Math.log(goal/start)/Math.log(1+expR*risk)) : 0;
  const days = Math.ceil(trades/tpd);
  const months = (days/21).toFixed(1);
  $('gExpV').textContent = `$${expDollar.toFixed(2)}`;
  $('gEdge').textContent = `${edgePct.toFixed(2)}%`;
  $('gTrades').textContent = trades;
  $('gDays').textContent = days;
  $('gMonths').textContent = months;
}

function calcPip(){
  const e = +$('pEntry').value||0;
  const x = +$('pExit').value||0;
  const dir = $('pDir').value;
  const lots = +$('pLots').value||0;
  const ts = +$('pTickSz').value||0.25;
  const tv = +$('pTickVal').value||0;
  const diff = dir==='long' ? x-e : e-x;
  const ticks = diff/ts;
  const pnl = ticks*tv*lots;
  $('pPts').textContent = diff.toFixed(2);
  $('pTicks').textContent = ticks.toFixed(0);
  $('pPnl').textContent = `$${pnl.toFixed(2)}`;
  $('pPnl').style.color = pnl>=0?'var(--green)':'var(--red)';
}

/* ==================== ADD TRADE ==================== */
function addTrade(){
  const t = {
    num: trades.length ? Math.max(...trades.map(x=>x.num))+1 : 1,
    date:$('fDate').value, day:$('fDay').value, instrument:$('fInst').value,
    session:$('fSess').value, time:$('fTime').value, size:+$('fSize').value,
    rr:$('fRR').value, duration:$('fDur').value, dir:$('fDir').value,
    outcome:$('fOut').value, pnl:+$('fPnl').value, score:+$('fScore').value,
    notes:$('fNotes').value
  };
  if(!t.date){alert('Please select a date');return;}
  trades.push(t); saveTrades(); renderAll(); resetForm();
  alert(`Trade #${t.num} added`);
}
function resetForm(){
  ['fDate','fTime','fRR','fDur','fPnl','fNotes'].forEach(id=>$(id).value='');
  $('fSize').value=0.01;$('fScore').value=3;
}

/* ==================== STORAGE INFO ==================== */
function renderStorage(){
  const blob = JSON.stringify(trades);
  const bytes = new Blob([blob]).size;
  const kb = (bytes/1024).toFixed(2);
  const limitMB = 5;
  const pct = (bytes/(limitMB*1024*1024)*100).toFixed(2);
  const free = (limitMB*1024 - bytes/1024).toFixed(0);
  const avg = trades.length ? (bytes/trades.length).toFixed(0) : 0;
  $('stTrades').textContent = trades.length;
  $('stUsed').textContent = `${kb} KB`;
  $('stPct').textContent = `${pct}% of quota`;
  $('stFree').textContent = `${free} KB`;
  $('stAvg').textContent = `${avg} B`;
  $('stUsedTxt').textContent = `${kb} KB / ${limitMB} MB`;
  $('stBar').style.width = Math.min(pct,100)+'%';
  const cap = avg>0 ? Math.floor((limitMB*1024*1024)/avg) : 10000;
  $('stCap').textContent = `~${cap.toLocaleString()} trades`;
  const last = localStorage.getItem(STORAGE_KEY+'_lastSave');
  $('stLast').textContent = last ? new Date(last).toLocaleString() : 'Never';
}

