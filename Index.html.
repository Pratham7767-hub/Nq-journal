/* ==================== METRICS ==================== */
function computeMetrics(){
  const t = trades;
  if(!t.length) return {total:0,wins:0,losses:0,winRate:0,netPnl:0,grossProfit:0,grossLoss:0,pf:0,avgWin:0,avgLoss:0,avgRR:0,best:null,worst:null,expectancy:0,maxDD:0,winStreak:0,lossStreak:0,sharpe:0,recoveryFactor:0,sd:0,kelly:0};
  const wins = t.filter(x => x.pnl > 0);
  const losses = t.filter(x => x.pnl < 0);
  const grossProfit = wins.reduce((s,x)=>s+x.pnl,0);
  const grossLoss = Math.abs(losses.reduce((s,x)=>s+x.pnl,0));
  const netPnl = grossProfit - grossLoss;
  const winRate = wins.length / t.length * 100;
  const avgWin = wins.length ? grossProfit / wins.length : 0;
  const avgLoss = losses.length ? grossLoss / losses.length : 0;
  const expectancy = (winRate/100) * avgWin - ((100-winRate)/100) * avgLoss;
  const pf = grossLoss > 0 ? grossProfit / grossLoss : grossProfit;
  const best = t.reduce((a,b)=>b.pnl>(a?.pnl??-Infinity)?b:a,null);
  const worst = t.reduce((a,b)=>b.pnl<(a?.pnl??Infinity)?b:a,null);
  // R:R parse avg
  const rrs = t.map(x => parseFloat((x.rr||'').split(':')[1]||0)).filter(x=>x);
  const avgRR = rrs.length ? rrs.reduce((s,x)=>s+x,0)/rrs.length : 0;
  // Drawdown
  const sorted = [...t].sort((a,b)=>new Date(a.date)-new Date(b.date));
  let cum=0, peak=0, maxDD=0;
  sorted.forEach(x=>{cum+=x.pnl; if(cum>peak)peak=cum; const dd=peak-cum; if(dd>maxDD)maxDD=dd;});
  // Streaks
  let curW=0,curL=0,maxW=0,maxL=0;
  sorted.forEach(x=>{
    if(x.pnl>0){curW++;curL=0;if(curW>maxW)maxW=curW;}
    else if(x.pnl<0){curL++;curW=0;if(curL>maxL)maxL=curL;}
    else {curW=0;curL=0;}
  });
  // Sharpe (simplified)
  const mean = netPnl / t.length;
  const variance = t.reduce((s,x)=>s+Math.pow(x.pnl-mean,2),0)/t.length;
  const sd = Math.sqrt(variance);
  const sharpe = sd>0 ? (mean/sd)*Math.sqrt(252) : 0;
  const recoveryFactor = maxDD>0 ? netPnl/maxDD : 0;
  // Kelly
  const W = winRate/100; const R = avgWin/(avgLoss||1);
  const kelly = R>0 ? (W - (1-W)/R)*100 : 0;
  return {total:t.length,wins:wins.length,losses:losses.length,winRate,netPnl,grossProfit,grossLoss,pf,avgWin,avgLoss,avgRR,best,worst,expectancy,maxDD,winStreak:maxW,lossStreak:maxL,sharpe,recoveryFactor,sd,kelly};
}

