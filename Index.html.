<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Trading Journal Pro — Advanced Analytics</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
:root {
  --bg: #0a0c0f;
  --bg2: #111318;
  --bg3: #181b22;
  --bg4: #1e2229;
  --border: rgba(255,255,255,0.07);
  --border2: rgba(255,255,255,0.12);
  --text: #e8eaf0;
  --muted: #6b7280;
  --muted2: #9ca3af;
  --green: #10d98a;
  --green-bg: rgba(16,217,138,0.1);
  --green-border: rgba(16,217,138,0.25);
  --red: #ff4d6d;
  --red-bg: rgba(255,77,109,0.1);
  --red-border: rgba(255,77,109,0.25);
  --accent: #6c63ff;
  --accent2: #a78bfa;
  --gold: #f5c842;
  --gold-bg: rgba(245,200,66,0.1);
  --blue: #38bdf8;
  --radius: 10px;
  --radius-lg: 16px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:'DM Mono',monospace;font-size:13px;min-height:100vh;overflow-x:hidden}
h1,h2,h3,.syne{font-family:'Syne',sans-serif}

/* LAYOUT */
.shell{display:flex;min-height:100vh}
.sidebar{width:210px;min-height:100vh;background:var(--bg2);border-right:1px solid var(--border);position:fixed;top:0;left:0;bottom:0;display:flex;flex-direction:column;z-index:100}
.main{margin-left:210px;flex:1;min-height:100vh}

/* SIDEBAR */
.sidebar-logo{padding:24px 20px 20px;border-bottom:1px solid var(--border)}
.sidebar-logo .title{font-family:'Syne',sans-serif;font-size:15px;font-weight:700;color:var(--text);letter-spacing:-.3px}
.sidebar-logo .sub{font-size:10px;color:var(--muted);margin-top:2px;letter-spacing:.05em}
.nav{padding:12px 8px;flex:1;overflow-y:auto}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:8px;cursor:pointer;color:var(--muted2);font-size:12px;font-family:'Syne',sans-serif;font-weight:500;transition:all .15s;margin-bottom:2px;border:none;background:none;width:100%;text-align:left}
.nav-item:hover{background:var(--bg3);color:var(--text)}
.nav-item.active{background:rgba(108,99,255,0.15);color:var(--accent2);border:1px solid rgba(108,99,255,0.2)}
.nav-icon{width:16px;height:16px;opacity:.7;flex-shrink:0}
.nav-item.active .nav-icon{opacity:1}
.sidebar-footer{padding:16px;border-top:1px solid var(--border)}
.stats-mini{background:var(--bg3);border-radius:8px;padding:10px 12px}
.stats-mini .sl{font-size:10px;color:var(--muted);margin-bottom:4px}
.stats-mini .sv{font-size:16px;font-weight:600;font-family:'Syne',sans-serif}

/* ACCOUNT BANNER */
.acct-banner{background:linear-gradient(135deg,rgba(108,99,255,0.12),rgba(16,217,138,0.06));border:1px solid rgba(108,99,255,0.25);border-radius:var(--radius-lg);padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.acct-banner-input-wrap{display:flex;align-items:center;gap:10px}
.acct-banner-label{font-size:11px;color:var(--muted2);white-space:nowrap;font-family:'Syne',sans-serif;font-weight:600;letter-spacing:.03em}
.acct-input{background:var(--bg3);border:1px solid rgba(108,99,255,0.35);color:var(--text);padding:7px 12px;border-radius:7px;font-size:14px;font-family:'DM Mono',monospace;outline:none;width:150px;transition:border-color .15s;font-weight:500}
.acct-input:focus{border-color:var(--accent)}
.acct-stats{display:flex;gap:24px;flex-wrap:wrap;flex:1;justify-content:flex-end}
.acct-stat{display:flex;flex-direction:column;align-items:flex-end;gap:2px}
.acct-stat .as-label{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em}
.acct-stat .as-val{font-family:'Syne',sans-serif;font-size:15px;font-weight:700}
.acct-progress-wrap{width:100%;margin-top:6px}
.acct-progress-bar{height:4px;border-radius:2px;background:var(--bg4);overflow:hidden;margin-top:4px}
.acct-progress-fill{height:100%;border-radius:2px;transition:width .5s,background .3s}

/* TOPBAR */
.topbar{padding:20px 32px 0;display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.topbar h1{font-size:22px;font-weight:700;letter-spacing:-.5px}
.topbar .crumb{font-size:11px;color:var(--muted);margin-top:2px}
.badge-live{background:var(--green-bg);border:1px solid var(--green-border);color:var(--green);font-size:10px;padding:3px 10px;border-radius:20px;letter-spacing:.05em;display:inline-flex;align-items:center;gap:6px}
.badge-live::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green)}

/* SECTIONS */
.section{display:none;padding:20px 32px 48px}
.section.active{display:block;animation:fadeUp .25s ease}

/* METRIC CARDS */
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:24px}
.metric-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius-lg);padding:16px 18px;position:relative;overflow:hidden;transition:border-color .2s}
.metric-card:hover{border-color:var(--border2)}
.metric-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.metric-card.green::before{background:var(--green)}
.metric-card.red::before{background:var(--red)}
.metric-card.gold::before{background:var(--gold)}
.metric-card.purple::before{background:var(--accent)}
.metric-card.blue::before{background:var(--blue)}
.mc-label{font-size:10px;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;margin-bottom:8px}
.mc-value{font-family:'Syne',sans-serif;font-size:24px;font-weight:700;line-height:1;margin-bottom:4px}
.mc-value.pos{color:var(--green)}.mc-value.neg{color:var(--red)}.mc-value.neu{color:var(--text)}.mc-value.gold{color:var(--gold)}.mc-value.blue{color:var(--blue)}
.mc-sub{font-size:10px;color:var(--muted)}

/* CALENDAR */
.cal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.cal-nav{display:flex;gap:8px;align-items:center}
.cal-btn{background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:6px 14px;border-radius:6px;cursor:pointer;font-size:12px;font-family:'DM Mono',monospace;transition:all .15s}
.cal-btn:hover{border-color:var(--border2);background:var(--bg4)}
.cal-month{font-family:'Syne',sans-serif;font-size:18px;font-weight:700;min-width:160px;text-align:center}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.cal-day-header{text-align:center;font-size:10px;color:var(--muted);padding:6px 0;letter-spacing:.05em;text-transform:uppercase}
.cal-cell{background:var(--bg2);border:1px solid var(--border);border-radius:8px;min-height:80px;padding:6px 8px;position:relative;cursor:pointer;transition:all .15s}
.cal-cell:hover{border-color:var(--border2);background:var(--bg3)}
.cal-cell.empty{background:transparent;border-color:transparent;cursor:default}
.cal-cell.today{border-color:var(--accent);box-shadow:0 0 0 1px rgba(108,99,255,.3)}
.cal-cell.has-win{border-color:var(--green-border);background:rgba(16,217,138,0.06)}
.cal-cell.has-loss{border-color:var(--red-border);background:rgba(255,77,109,0.06)}
.cal-cell.has-both{border-color:rgba(245,200,66,.3);background:rgba(245,200,66,.04)}
.cal-dn{font-size:11px;color:var(--muted);font-weight:500}
.cal-pnl{font-size:13px;font-weight:600;font-family:'Syne',sans-serif;margin-top:4px}
.cal-pnl.pos{color:var(--green)}.cal-pnl.neg{color:var(--red)}
.cal-trades{font-size:9px;color:var(--muted);margin-top:2px}
.cal-dots{display:flex;gap:2px;margin-top:4px;flex-wrap:wrap}
.cal-dot{width:5px;height:5px;border-radius:50%}
.cal-dot.win{background:var(--green)}.cal-dot.loss{background:var(--red)}

.cal-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:16px}
.cs-card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:12px 14px}
.cs-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px}
.cs-val{font-family:'Syne',sans-serif;font-size:18px;font-weight:700}

/* TRADE TABLE */
.table-wrap{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden}
.table-controls{padding:16px 20px;display:flex;gap:10px;align-items:center;border-bottom:1px solid var(--border);flex-wrap:wrap}
.table-controls input,.table-controls select{background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:6px 10px;border-radius:6px;font-size:12px;font-family:'DM Mono',monospace;outline:none}
.table-controls input:focus,.table-controls select:focus{border-color:var(--accent)}
.tbl-scroll{overflow-x:auto;max-height:600px;overflow-y:auto}
.tbl{width:100%;border-collapse:collapse}
.tbl th{padding:10px 12px;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid var(--border);text-align:left;white-space:nowrap;background:var(--bg2);font-family:'Syne',sans-serif;font-weight:600;cursor:pointer;position:sticky;top:0;z-index:5}
.tbl th:hover{color:var(--text)}
.tbl td{padding:10px 12px;border-bottom:1px solid var(--border);white-space:nowrap;vertical-align:middle;font-size:12px}
.tbl tr:last-child td{border-bottom:none}
.tbl tr:hover td{background:rgba(255,255,255,0.02)}
.pill{display:inline-block;padding:2px 9px;border-radius:20px;font-size:10px;font-weight:500;font-family:'Syne',sans-serif}
.pill.long{background:rgba(16,217,138,0.12);color:var(--green);border:1px solid var(--green-border)}
.pill.short{background:rgba(255,77,109,0.12);color:var(--red);border:1px solid var(--red-border)}
.pill.tp{background:rgba(16,217,138,0.12);color:var(--green);border:1px solid var(--green-border)}
.pill.sl{background:rgba(255,77,109,0.12);color:var(--red);border:1px solid var(--red-border)}
.pill.trail{background:var(--gold-bg);color:var(--gold);border:1px solid rgba(245,200,66,.25)}
.pill.be{background:rgba(156,163,175,0.12);color:var(--muted2);border:1px solid var(--border2)}
.pnl-pos{color:var(--green);font-weight:600}
.pnl-neg{color:var(--red);font-weight:600}
.score-bar{display:flex;gap:2px;align-items:center}
.score-pip{width:8px;height:8px;border-radius:2px;background:var(--bg4)}
.score-pip.filled{background:var(--accent2)}

/* CHARTS SECTION */
.charts-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.chart-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px}
.chart-card.full{grid-column:1/-1}
.chart-title{font-family:'Syne',sans-serif;font-size:13px;font-weight:600;margin-bottom:16px;color:var(--muted2);display:flex;justify-content:space-between;align-items:center}
.chart-wrap{position:relative;width:100%;height:240px}
canvas{display:block}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:1000;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s;backdrop-filter:blur(4px)}
.modal-overlay.open{opacity:1;pointer-events:all}
.modal{background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius-lg);width:600px;max-width:95vw;max-height:90vh;overflow-y:auto;padding:28px}
.modal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}
.modal-title{font-family:'Syne',sans-serif;font-size:18px;font-weight:700}
.modal-close{background:var(--bg3);border:1px solid var(--border);color:var(--muted2);width:30px;height:30px;border-radius:6px;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.modal-close:hover{color:var(--text);border-color:var(--border2)}
.modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.modal-field{background:var(--bg3);border-radius:8px;padding:10px 12px}
.modal-field .mf-label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px}
.modal-field .mf-value{font-size:14px;font-weight:500;font-family:'Syne',sans-serif}
.notes-box{background:var(--bg3);border-radius:8px;padding:12px;font-size:12px;color:var(--muted2);line-height:1.6;margin-top:8px;min-height:50px}
.divider{height:1px;background:var(--border);margin:16px 0}

/* DAY POPUP MODAL */
.day-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:2000;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s;backdrop-filter:blur(6px)}
.day-modal-overlay.open{opacity:1;pointer-events:all}
.day-modal{background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius-lg);width:720px;max-width:96vw;max-height:88vh;overflow-y:auto;padding:0;display:flex;flex-direction:column}
.day-modal-head{padding:22px 26px 18px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--bg2);z-index:10;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.day-modal-date{font-family:'Syne',sans-serif;font-size:20px;font-weight:700;letter-spacing:-.4px}
.day-modal-sub{font-size:11px;color:var(--muted);margin-top:3px}
.day-modal-close{background:var(--bg3);border:1px solid var(--border);color:var(--muted2);width:32px;height:32px;border-radius:7px;cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .15s}
.day-modal-close:hover{color:var(--text);border-color:var(--border2)}
.day-modal-body{padding:20px 26px 26px;display:flex;flex-direction:column;gap:20px}

/* Day summary strip */
.day-summary-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
.dss-card{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px 14px;text-align:center}
.dss-label{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px}
.dss-val{font-family:'Syne',sans-serif;font-size:18px;font-weight:700}

/* Individual trade cards in day popup */
.day-trade-list{display:flex;flex-direction:column;gap:10px}
.day-trade-card{background:var(--bg3);border:1px solid var(--border);border-radius:10px;overflow:hidden;transition:border-color .15s}
.day-trade-card:hover{border-color:var(--border2)}
.day-trade-card.win-card{border-left:3px solid var(--green)}
.day-trade-card.loss-card{border-left:3px solid var(--red)}
.day-trade-card.be-card{border-left:3px solid var(--muted)}
.day-trade-card.trail-card{border-left:3px solid var(--gold)}
.dtc-header{padding:11px 14px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--border);flex-wrap:wrap}
.dtc-num{font-family:'Syne',sans-serif;font-size:12px;font-weight:700;color:var(--muted2)}
.dtc-pnl{font-family:'Syne',sans-serif;font-size:16px;font-weight:700;margin-left:auto}
.dtc-pnl.pos{color:var(--green)}.dtc-pnl.neg{color:var(--red)}.dtc-pnl.zero{color:var(--muted2)}
.dtc-body{padding:12px 14px;display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.dtc-field{display:flex;flex-direction:column;gap:3px}
.dtc-field .dtf-label{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.dtc-field .dtf-val{font-size:12px;font-weight:500;font-family:'Syne',sans-serif;color:var(--text)}
.dtc-notes{padding:0 14px 12px;font-size:11px;color:var(--muted2);line-height:1.6;background:rgba(0,0,0,.15);margin:0 -0px;border-top:1px dashed var(--border)}
.dtc-notes-inner{padding:8px 0}
.dtc-score-bar{display:flex;gap:3px;align-items:center}
.dtc-score-pip{width:9px;height:9px;border-radius:2px;background:var(--bg4)}
.dtc-score-pip.filled{background:var(--accent2)}

/* day P&L breakdown bar */
.day-pnl-bar-wrap{background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:14px 16px}
.day-pnl-bar-title{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}
.day-pnl-bar-track{height:8px;border-radius:4px;background:var(--bg4);overflow:hidden;display:flex}
.dpb-win{background:var(--green);height:100%;transition:width .4s}
.dpb-loss{background:var(--red);height:100%;transition:width .4s}
.day-pnl-bar-legend{display:flex;gap:16px;margin-top:8px;font-size:11px;color:var(--muted2)}
.dpbl-dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:5px;vertical-align:middle}

/* STATS */
.stats-two{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.stats-three{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:16px}
.stat-group{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px}
.stat-group-title{font-family:'Syne',sans-serif;font-size:12px;font-weight:600;color:var(--muted2);margin-bottom:14px;text-transform:uppercase;letter-spacing:.06em}
.stat-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border)}
.stat-row:last-child{border-bottom:none}
.stat-row .sr-label{font-size:12px;color:var(--muted2)}
.stat-row .sr-val{font-size:13px;font-weight:600;font-family:'Syne',sans-serif}

/* FORM */
.form-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius-lg);padding:24px;margin-bottom:16px}
.form-title{font-family:'Syne',sans-serif;font-size:14px;font-weight:600;margin-bottom:18px;color:var(--muted2);text-transform:uppercase;letter-spacing:.06em}
.form-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:12px}
.form-grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:12px}
.form-field label{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px}
.form-field input,.form-field select,.form-field textarea{width:100%;background:var(--bg3);border:1px solid var(--border);color:var(--text);padding:9px 11px;border-radius:6px;font-size:12px;font-family:'DM Mono',monospace;outline:none;transition:border-color .15s}
.form-field input:focus,.form-field select:focus,.form-field textarea:focus{border-color:var(--accent)}
.form-field textarea{resize:vertical;min-height:70px}
.form-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:8px}
.btn{padding:9px 20px;border-radius:7px;cursor:pointer;font-size:12px;font-family:'Syne',sans-serif;font-weight:600;transition:all .15s;border:1px solid transparent;letter-spacing:.02em}
.btn-primary{background:var(--accent);color:#fff;border-color:var(--accent)}
.btn-primary:hover{background:#5a52d5}
.btn-ghost{background:transparent;color:var(--muted2);border-color:var(--border)}
.btn-ghost:hover{border-color:var(--border2);color:var(--text)}
.btn-gold{background:var(--gold);color:#000;border-color:var(--gold)}
.btn-gold:hover{filter:brightness(1.1)}

/* CALCULATOR */
.calc-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.calc-result{background:linear-gradient(135deg,rgba(108,99,255,0.08),rgba(167,139,250,0.04));border:1px solid rgba(108,99,255,0.2);border-radius:12px;padding:20px;margin-top:16px}
.calc-result-title{font-family:'Syne',sans-serif;font-size:11px;color:var(--accent2);text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px}
.calc-result-row{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px dashed var(--border)}
.calc-result-row:last-child{border-bottom:none}
.calc-result-label{font-size:12px;color:var(--muted2)}
.calc-result-val{font-family:'Syne',sans-serif;font-size:16px;font-weight:700}

/* GLOSSARY */
.glossary-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
.glossary-card{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:14px 16px;transition:all .15s}
.glossary-card:hover{border-color:var(--border2);transform:translateY(-2px)}
.glossary-term{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;color:var(--accent2);margin-bottom:4px}
.glossary-abbr{font-size:10px;color:var(--gold);margin-bottom:8px;letter-spacing:.05em}
.glossary-desc{font-size:11px;color:var(--muted2);line-height:1.6}

/* SCROLLBAR */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--bg4);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--border2)}

/* RISK METER */
.risk-meter{height:6px;border-radius:3px;background:var(--bg4);overflow:hidden;margin-top:6px}
.risk-fill{height:100%;border-radius:3px;transition:width .5s}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}

.empty-state{text-align:center;padding:60px 20px;color:var(--muted)}

/* HEATMAP */
.heatmap{display:grid;grid-template-columns:80px repeat(24,1fr);gap:2px;font-size:9px}
.hm-cell{aspect-ratio:1;background:var(--bg3);border-radius:2px;display:flex;align-items:center;justify-content:center;font-size:8px}
.hm-label{display:flex;align-items:center;justify-content:flex-end;padding-right:6px;color:var(--muted);font-size:9px}

/* SESSION CARDS */
.session-card{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:8px}
.session-card.ny-am{border-left:3px solid var(--blue)}
.session-card.ny-pm{border-left:3px solid var(--gold)}
.session-card.london{border-left:3px solid var(--accent)}
.session-card.asia{border-left:3px solid var(--green)}

/* CHECKLIST */
.checklist{background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:18px}
.cl-item{display:flex;align-items:center;gap:10px;padding:7px 0;font-size:12px;color:var(--muted2)}
.cl-item input[type="checkbox"]{accent-color:var(--accent);width:14px;height:14px;cursor:pointer}
.cl-item label{cursor:pointer;flex:1}

@media(max-width:900px){
  .sidebar{width:60px}
  .sidebar-logo .title,.sidebar-logo .sub,.nav-item span,.sidebar-footer{display:none}
  .nav-item{justify-content:center;padding:12px}
  .main{margin-left:60px}
  .charts-grid,.stats-two,.stats-three,.calc-grid{grid-template-columns:1fr}
  .topbar{padding:16px 16px 0}
  .section{padding:16px}
}
</style>
</head>
<body>
<div class="shell">
<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="sidebar-logo">
    <div class="title">TRADING JOURNAL</div>
    <div class="sub">PRO • NQ FUTURES</div>
  </div>
  <nav class="nav">
    <button class="nav-item active" data-tab="dashboard">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      <span>Dashboard</span>
    </button>
    <button class="nav-item" data-tab="trades">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      <span>Trade Log</span>
    </button>
    <button class="nav-item" data-tab="calendar">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span>P&amp;L Calendar</span>
    </button>
    <button class="nav-item" data-tab="analytics">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      <span>Analytics</span>
    </button>
    <button class="nav-item" data-tab="sessions">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>Sessions</span>
    </button>
    <button class="nav-item" data-tab="calculator">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="14" x2="8" y2="14"/><line x1="12" y1="14" x2="12" y2="14"/><line x1="16" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="8" y2="18"/><line x1="12" y1="18" x2="12" y2="18"/><line x1="16" y1="18" x2="16" y2="18"/></svg>
      <span>Calculator</span>
    </button>
    <button class="nav-item" data-tab="addtrade">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      <span>Add Trade</span>
    </button>
    <button class="nav-item" data-tab="checklist">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
      <span>Pre-Trade</span>
    </button>
    <button class="nav-item" data-tab="storage">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
      <span>Storage</span>
    </button>
    <button class="nav-item" data-tab="glossary">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <span>Glossary</span>
    </button>
  </nav>
  <div class="sidebar-footer">
    <div class="stats-mini" style="margin-bottom:8px">
      <div class="sl">NET P&amp;L</div>
      <div class="sv" id="sidePnl">$0.00</div>
    </div>
    <div class="stats-mini">
      <div class="sl" style="margin-bottom:5px">ACCOUNT SIZE</div>
      <input type="number" id="sideAcctSize" placeholder="e.g. 10000" step="100" min="0"
        style="width:100%;background:var(--bg4);border:1px solid var(--border2);color:var(--text);padding:5px 8px;border-radius:5px;font-size:13px;font-family:'DM Mono',monospace;outline:none"
        oninput="onAcctChange(this.value)">
    </div>
  </div>
</aside>

<!-- MAIN -->
<main class="main">
  <div class="topbar">
    <div>
      <h1 id="pageTitle">Dashboard</h1>
      <div class="crumb" id="pageCrumb">Overview · Performance metrics</div>
    </div>
    <div class="badge-live">LIVE TRACKING</div>
  </div>

  <!-- DASHBOARD -->
  <section class="section active" id="sec-dashboard">

    <!-- ACCOUNT OVERVIEW BANNER -->
    <div class="acct-banner" id="acctBanner">
      <div class="acct-banner-input-wrap">
        <span class="acct-banner-label">💰 Account Size</span>
        <input type="number" id="acctSizeInput" class="acct-input" placeholder="e.g. 10000" step="100" min="0" oninput="onAcctChange(this.value)">
        <span style="font-size:11px;color:var(--muted)">USD</span>
      </div>
      <div class="acct-stats" id="acctStats">
        <div class="acct-stat">
          <span class="as-label">Current Balance</span>
          <span class="as-val" id="acctBalance" style="color:var(--text)">—</span>
        </div>
        <div class="acct-stat">
          <span class="as-label">Return %</span>
          <span class="as-val" id="acctReturn">—</span>
        </div>
        <div class="acct-stat">
          <span class="as-label">Max DD %</span>
          <span class="as-val" id="acctDDpct" style="color:var(--red)">—</span>
        </div>
        <div class="acct-stat">
          <span class="as-label">Risk / Trade (1%)</span>
          <span class="as-val" id="acctRiskAmt" style="color:var(--gold)">—</span>
        </div>
      </div>
      <div class="acct-progress-wrap" id="acctProgressWrap" style="display:none">
        <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-bottom:3px">
          <span>Starting Capital</span>
          <span id="acctProgressLbl">0%</span>
          <span>Current Balance</span>
        </div>
        <div class="acct-progress-bar"><div class="acct-progress-fill" id="acctProgressFill" style="width:50%"></div></div>
      </div>
    </div>

    <div class="metrics">
      <div class="metric-card green"><div class="mc-label">Net P&amp;L</div><div class="mc-value pos" id="mNetPnl">$0.00</div><div class="mc-sub" id="mNetPnlSub">Total realized</div></div>
      <div class="metric-card blue"><div class="mc-label">Win Rate</div><div class="mc-value blue" id="mWinRate">0%</div><div class="mc-sub" id="mWinRateSub">0 / 0 trades</div></div>
      <div class="metric-card gold"><div class="mc-label">Profit Factor</div><div class="mc-value gold" id="mPf">0.00</div><div class="mc-sub">Gross profit / loss</div></div>
      <div class="metric-card purple"><div class="mc-label">Avg R:R</div><div class="mc-value neu" id="mRR">0.00</div><div class="mc-sub">Risk-Reward ratio</div></div>
      <div class="metric-card green"><div class="mc-label">Best Trade</div><div class="mc-value pos" id="mBest">$0.00</div><div class="mc-sub" id="mBestDate">—</div></div>
      <div class="metric-card red"><div class="mc-label">Worst Trade</div><div class="mc-value neg" id="mWorst">$0.00</div><div class="mc-sub" id="mWorstDate">—</div></div>
      <div class="metric-card purple"><div class="mc-label">Total Trades</div><div class="mc-value neu" id="mTotal">0</div><div class="mc-sub" id="mTotalSub">0 wins · 0 losses</div></div>
      <div class="metric-card gold"><div class="mc-label">Expectancy</div><div class="mc-value gold" id="mExp">$0.00</div><div class="mc-sub">Per trade</div></div>
      <div class="metric-card green" id="mcReturnCard" style="display:none"><div class="mc-label">Total Return</div><div class="mc-value pos" id="mReturn">0.00%</div><div class="mc-sub" id="mReturnSub">vs initial capital</div></div>
      <div class="metric-card red" id="mcDDCard" style="display:none"><div class="mc-label">Max DD %</div><div class="mc-value neg" id="mDDpct">0.00%</div><div class="mc-sub" id="mDDpctSub">of account</div></div>
    </div>

    <div class="charts-grid">
      <div class="chart-card full">
        <div class="chart-title"><span>Equity Curve</span><span style="font-size:10px;color:var(--muted)">Cumulative P&amp;L</span></div>
        <div class="chart-wrap" style="height:280px"><canvas id="equityChart"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">Win/Loss Distribution</div>
        <div class="chart-wrap"><canvas id="wlChart"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">Long vs Short Performance</div>
        <div class="chart-wrap"><canvas id="lsChart"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">Session Performance</div>
        <div class="chart-wrap"><canvas id="sessionChart"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">Day-of-Week P&amp;L</div>
        <div class="chart-wrap"><canvas id="dowChart"></canvas></div>
      </div>
    </div>
  </section>

  <!-- TRADES -->
  <section class="section" id="sec-trades">
    <div class="table-wrap">
      <div class="table-controls">
        <input type="text" id="searchTrades" placeholder="Search notes / instrument…" style="flex:1;min-width:200px">
        <select id="filterDir"><option value="">All Directions</option><option value="Long">Long</option><option value="Short">Short</option></select>
        <select id="filterOutcome"><option value="">All Outcomes</option><option value="TP">TP (Win)</option><option value="SL">SL (Loss)</option><option value="BE">Break-Even</option><option value="Trailing stop">Trailing</option></select>
        <select id="filterSession"><option value="">All Sessions</option><option value="NY am">NY AM</option><option value="NY pm">NY PM</option><option value="London">London</option><option value="Asia">Asia</option></select>
        <button class="btn btn-ghost" onclick="exportCSV()">Export CSV</button>
      </div>
      <div class="tbl-scroll">
        <table class="tbl" id="tradeTable">
          <thead><tr>
            <th data-sort="num">#</th><th data-sort="date">Date</th><th data-sort="day">Day</th>
            <th data-sort="instrument">Instrument</th><th data-sort="session">Session</th>
            <th data-sort="time">Entry Time</th><th data-sort="size">Size</th>
            <th data-sort="rr">R:R</th><th data-sort="duration">Duration</th>
            <th data-sort="dir">Direction</th><th data-sort="outcome">Outcome</th>
            <th data-sort="pnl">P&amp;L</th><th data-sort="score">Score</th>
            <th>Notes</th>
          </tr></thead>
          <tbody id="tradeBody"></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CALENDAR -->
  <section class="section" id="sec-calendar">
    <div class="cal-header">
      <div class="cal-nav">
        <button class="cal-btn" onclick="changeMonth(-1)">◀ Prev</button>
        <div class="cal-month" id="calMonth">—</div>
        <button class="cal-btn" onclick="changeMonth(1)">Next ▶</button>
      </div>
      <div class="cal-nav">
        <button class="cal-btn" onclick="jumpToToday()">Today</button>
      </div>
    </div>
    <div class="cal-grid" id="calGridHeader"></div>
    <div class="cal-grid" id="calGrid" style="margin-top:3px"></div>
    <div class="cal-summary">
      <div class="cs-card"><div class="cs-label">Month P&amp;L</div><div class="cs-val" id="csMonthPnl">$0.00</div></div>
      <div class="cs-card" id="csReturnCard" style="display:none"><div class="cs-label">Month Return %</div><div class="cs-val" id="csMonthReturn">—</div></div>
      <div class="cs-card"><div class="cs-label">Trading Days</div><div class="cs-val" id="csTradeDays">0</div></div>
      <div class="cs-card"><div class="cs-label">Win Days</div><div class="cs-val" style="color:var(--green)" id="csWinDays">0</div></div>
      <div class="cs-card"><div class="cs-label">Loss Days</div><div class="cs-val" style="color:var(--red)" id="csLossDays">0</div></div>
    </div>
  </section>

  <!-- ANALYTICS -->
  <section class="section" id="sec-analytics">
    <div class="stats-three">
      <div class="stat-group">
        <div class="stat-group-title">Performance Stats</div>
        <div class="stat-row"><span class="sr-label">Gross Profit</span><span class="sr-val pnl-pos" id="sGP">$0</span></div>
        <div class="stat-row"><span class="sr-label">Gross Loss</span><span class="sr-val pnl-neg" id="sGL">$0</span></div>
        <div class="stat-row"><span class="sr-label">Net P&amp;L</span><span class="sr-val" id="sNet">$0</span></div>
        <div class="stat-row"><span class="sr-label">Profit Factor</span><span class="sr-val" id="sPF">0</span></div>
        <div class="stat-row"><span class="sr-label">Expectancy</span><span class="sr-val" id="sExp">$0</span></div>
        <div class="stat-row"><span class="sr-label">Sharpe Ratio</span><span class="sr-val" id="sSharpe">0</span></div>
        <div class="stat-row" id="aRowReturn" style="display:none"><span class="sr-label">Total Return %</span><span class="sr-val" id="aReturn">—</span></div>
        <div class="stat-row" id="aRowBalance" style="display:none"><span class="sr-label">Current Balance</span><span class="sr-val" id="aBalance">—</span></div>
      </div>
      <div class="stat-group">
        <div class="stat-group-title">Win/Loss Breakdown</div>
        <div class="stat-row"><span class="sr-label">Win Rate</span><span class="sr-val" id="sWR">0%</span></div>
        <div class="stat-row"><span class="sr-label">Loss Rate</span><span class="sr-val" id="sLR">0%</span></div>
        <div class="stat-row"><span class="sr-label">Avg Win</span><span class="sr-val pnl-pos" id="sAW">$0</span></div>
        <div class="stat-row"><span class="sr-label">Avg Loss</span><span class="sr-val pnl-neg" id="sAL">$0</span></div>
        <div class="stat-row"><span class="sr-label">Avg R:R</span><span class="sr-val" id="sARR">0</span></div>
        <div class="stat-row"><span class="sr-label">Largest Win/Loss</span><span class="sr-val" id="sLWL">—</span></div>
      </div>
      <div class="stat-group">
        <div class="stat-group-title">Risk Metrics</div>
        <div class="stat-row"><span class="sr-label">Max Drawdown</span><span class="sr-val pnl-neg" id="sDD">$0</span></div>
        <div class="stat-row" id="aRowDD" style="display:none"><span class="sr-label">Max DD % of Acct</span><span class="sr-val pnl-neg" id="sDDpct">—</span></div>
        <div class="stat-row"><span class="sr-label">Max Win Streak</span><span class="sr-val pnl-pos" id="sWS">0</span></div>
        <div class="stat-row"><span class="sr-label">Max Loss Streak</span><span class="sr-val pnl-neg" id="sLS">0</span></div>
        <div class="stat-row"><span class="sr-label">Recovery Factor</span><span class="sr-val" id="sRF">0</span></div>
        <div class="stat-row"><span class="sr-label">Standard Deviation</span><span class="sr-val" id="sSD">$0</span></div>
        <div class="stat-row"><span class="sr-label">Kelly %</span><span class="sr-val" id="sKelly">0%</span></div>
        <div class="stat-row" id="aRowRisk1" style="display:none"><span class="sr-label">1% Risk Amount</span><span class="sr-val" id="aRisk1" style="color:var(--gold)">—</span></div>
        <div class="stat-row" id="aRowRisk2" style="display:none"><span class="sr-label">2% Risk Amount</span><span class="sr-val" id="aRisk2" style="color:var(--gold)">—</span></div>
      </div>
    </div>
    <div class="charts-grid">
      <div class="chart-card full">
        <div class="chart-title">Drawdown Curve</div>
        <div class="chart-wrap" style="height:240px"><canvas id="ddChart"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">P&amp;L Distribution Histogram</div>
        <div class="chart-wrap"><canvas id="histChart"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">Score vs P&amp;L (Trade Quality)</div>
        <div class="chart-wrap"><canvas id="scoreChart"></canvas></div>
      </div>
    </div>
  </section>

  <!-- SESSIONS -->
  <section class="section" id="sec-sessions">
    <div class="metrics" id="sessionGrid"></div>
    <div class="charts-grid">
      <div class="chart-card">
        <div class="chart-title">Win Rate by Session</div>
        <div class="chart-wrap"><canvas id="sessWR"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">P&amp;L by Session</div>
        <div class="chart-wrap"><canvas id="sessPnl"></canvas></div>
      </div>
      <div class="chart-card full">
        <div class="chart-title">Trade Volume by Day &amp; Session</div>
        <div class="chart-wrap" style="height:240px"><canvas id="sessHeat"></canvas></div>
      </div>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="section" id="sec-calculator">
    <div class="calc-grid">
      <!-- POSITION SIZE CALC -->
      <div class="form-card">
        <div class="form-title">Position Size Calculator</div>
        <div class="form-grid-2">
          <div class="form-field"><label>Account Balance ($)</label><input type="number" id="cAcc" value="10000" step="100"></div>
          <div class="form-field"><label>Risk Per Trade (%)</label><input type="number" id="cRisk" value="1" step="0.1"></div>
          <div class="form-field"><label>Entry Price</label><input type="number" id="cEntry" value="20000" step="0.25"></div>
          <div class="form-field"><label>Stop Loss Price</label><input type="number" id="cStop" value="19975" step="0.25"></div>
          <div class="form-field"><label>Take Profit Price</label><input type="number" id="cTP" value="20050" step="0.25"></div>
          <div class="form-field"><label>Tick Value ($)</label><input type="number" id="cTick" value="5" step="0.5"></div>
          <div class="form-field"><label>Tick Size</label><input type="number" id="cTickSz" value="0.25" step="0.01"></div>
          <div class="form-field"><label>Commission ($/contract)</label><input type="number" id="cCom" value="2.5" step="0.1"></div>
        </div>
        <div class="calc-result">
          <div class="calc-result-title">Calculated Position</div>
          <div class="calc-result-row"><span class="calc-result-label">Risk Amount ($)</span><span class="calc-result-val" style="color:var(--red)" id="rRiskAmt">$0</span></div>
          <div class="calc-result-row"><span class="calc-result-label">Stop Distance (ticks)</span><span class="calc-result-val" id="rStopT">0</span></div>
          <div class="calc-result-row"><span class="calc-result-label">$ Risk per Contract</span><span class="calc-result-val" id="rRiskC">$0</span></div>
          <div class="calc-result-row"><span class="calc-result-label">Position Size (contracts)</span><span class="calc-result-val" style="color:var(--accent2)" id="rContracts">0</span></div>
          <div class="calc-result-row"><span class="calc-result-label">Potential Profit</span><span class="calc-result-val" style="color:var(--green)" id="rProfit">$0</span></div>
          <div class="calc-result-row"><span class="calc-result-label">Risk:Reward Ratio</span><span class="calc-result-val" style="color:var(--gold)" id="rRR">1:0</span></div>
        </div>
      </div>

      <!-- COMPOUNDING CALC -->
      <div class="form-card">
