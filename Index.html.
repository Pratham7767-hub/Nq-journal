/* ==================== NAV ==================== */
function setupNav(){
  document.querySelectorAll('.nav-item').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.querySelectorAll('.nav-item').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      const tab = btn.dataset.tab;
      document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
      $('sec-'+tab).classList.add('active');
      const titles = {
        dashboard:['Dashboard','Overview · Performance metrics'],
        trades:['Trade Log','All trades · sortable & filterable'],
        calendar:['P&L Calendar','Daily heat · monthly view'],
        analytics:['Analytics','Deep-dive performance metrics'],
        sessions:['Sessions','Session-based performance'],
        calculator:['Calculator','Position size · compounding · pip'],
        addtrade:['Add Trade','Log new trade entry'],
        checklist:['Pre-Trade Checklist','Discipline & process'],
        storage:['Storage','Data management & backup'],
        glossary:['Glossary','Trading terms reference']
      };
      $('pageTitle').textContent = titles[tab][0];
      $('pageCrumb').textContent = titles[tab][1];
      // refresh visualizations for active tab
      if(tab==='dashboard') drawCharts();
      if(tab==='analytics') drawAnalyticsCharts();
      if(tab==='sessions') renderSessions();
      if(tab==='storage') renderStorage();
      if(tab==='calendar') renderCalendar();
    });
  });
}

/* ==================== INIT ==================== */
function renderAll(){
  renderDashboard();
  renderTrades();
  renderCalendar();
  renderAnalytics();
  renderSessions();
  renderStorage();
}

function init(){
  loadTrades();
  loadAcctSize();
  setupNav();
  renderGlossary();
  renderAll();
  // Sync account size inputs on load
  if(accountSize > 0){
    $('acctSizeInput').value = accountSize;
    $('sideAcctSize').value = accountSize;
  }
  // filters
  ['searchTrades','filterDir','filterOutcome','filterSession'].forEach(id=>{
    $(id).addEventListener('input',renderTrades);
    $(id).addEventListener('change',renderTrades);
  });
  // calculators - live
  ['cAcc','cRisk','cEntry','cStop','cTP','cTick','cTickSz','cCom'].forEach(id=>$(id).addEventListener('input',calcPosition));
  ['gStart','gGoal','gWR','gRR','gRisk','gTPD'].forEach(id=>$(id).addEventListener('input',calcGoal));
  ['pEntry','pExit','pDir','pLots','pTickSz','pTickVal'].forEach(id=>$(id).addEventListener('input',calcPip));
  calcPosition(); calcGoal(); calcPip();
  // ESC modal
  document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal();closeDayModal();}});
}

document.addEventListener('DOMContentLoaded',init);
