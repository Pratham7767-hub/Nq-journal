/* ==================== CALENDAR ==================== */
function renderCalendar(){
  const headers = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  $('calGridHeader').innerHTML = headers.map(d=>`<div class="cal-day-header">${d}</div>`).join('');
  const y = calDate.getFullYear(); const m = calDate.getMonth();
  $('calMonth').textContent = calDate.toLocaleDateString('en',{month:'long',year:'numeric'});
  const first = new Date(y,m,1).getDay();
  const days = new Date(y,m+1,0).getDate();
  const today = new Date(); today.setHours(0,0,0,0);
  const daily = {};
  trades.forEach(t=>{
    const d = t.date;
    if(!daily[d]) daily[d] = {pnl:0,trades:[],wins:0,losses:0};
    daily[d].pnl += t.pnl; daily[d].trades.push(t);
    if(t.pnl>0) daily[d].wins++;
    else if(t.pnl<0) daily[d].losses++;
  });
  let html='';
  for(let i=0;i<first;i++) html+='<div class="cal-cell empty"></div>';
  let monthPnl=0,tradeDays=0,winDays=0,lossDays=0;
  for(let d=1;d<=days;d++){
    const dStr = `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const data = daily[dStr];
    const isToday = (new Date(y,m,d).getTime()===today.getTime());
    let cls = 'cal-cell';
    if(isToday) cls += ' today';
    let inner = `<div class="cal-dn">${d}</div>`;
    if(data){
      tradeDays++;
      monthPnl += data.pnl;
      if(data.pnl>0){cls+=' has-win';winDays++;}
      else if(data.pnl<0){cls+=' has-loss';lossDays++;}
      else cls+=' has-both';
      const pnlCls = data.pnl>=0?'pos':'neg';
      inner += `<div class="cal-pnl ${pnlCls}">${fmt(data.pnl)}</div>`;
      inner += `<div class="cal-trades">${data.trades.length} trade${data.trades.length>1?'s':''}</div>`;
      inner += `<div class="cal-dots">`;
      for(let i=0;i<data.wins;i++) inner += `<div class="cal-dot win"></div>`;
      for(let i=0;i<data.losses;i++) inner += `<div class="cal-dot loss"></div>`;
      inner += `</div>`;
    }
    html += `<div class="${cls}" onclick="showDayTrades('${dStr}')">${inner}</div>`;
  }
  $('calGrid').innerHTML = html;
  $('csMonthPnl').textContent = fmt(monthPnl);
  $('csMonthPnl').style.color = monthPnl>=0?'var(--green)':'var(--red)';
  $('csTradeDays').textContent = tradeDays;
  $('csWinDays').textContent = winDays;
  $('csLossDays').textContent = lossDays;

  // Month return % vs account size
  if(accountSize > 0){
    $('csReturnCard').style.display = '';
    const mRet = (monthPnl / accountSize * 100);
    $('csMonthReturn').textContent = (mRet>=0?'+':'')+mRet.toFixed(2)+'%';
    $('csMonthReturn').style.color = mRet>=0?'var(--green)':'var(--red)';
  } else {
    $('csReturnCard').style.display = 'none';
  }
}

