/* ==================== DASHBOARD ==================== */
function renderDashboard(){
  const m = computeMetrics();
  $('mNetPnl').textContent = fmt(m.netPnl);
  $('mNetPnl').className = 'mc-value '+(m.netPnl>=0?'pos':'neg');
  $('mNetPnlSub').textContent = `${m.total} trades`;
  $('sidePnl').textContent = fmt(m.netPnl);
  $('sidePnl').style.color = m.netPnl>=0?'var(--green)':'var(--red)';
  $('mWinRate').textContent = m.winRate.toFixed(1)+'%';
  $('mWinRateSub').textContent = `${m.wins} / ${m.total} trades`;
  $('mPf').textContent = m.pf.toFixed(2);
  $('mRR').textContent = '1:'+m.avgRR.toFixed(2);
  $('mBest').textContent = fmt(m.best?.pnl||0);
  $('mBestDate').textContent = m.best?.date||'—';
  $('mWorst').textContent = fmt(m.worst?.pnl||0);
  $('mWorstDate').textContent = m.worst?.date||'—';
  $('mTotal').textContent = m.total;
  $('mTotalSub').textContent = `${m.wins} wins · ${m.losses} losses`;
  $('mExp').textContent = fmt(m.expectancy);

  // Account-size dependent metrics
  const hasAcct = accountSize > 0;
  const currentBalance = hasAcct ? accountSize + m.netPnl : 0;
  const returnPct = hasAcct ? (m.netPnl / accountSize * 100) : 0;
  const ddPct = hasAcct && m.maxDD > 0 ? (m.maxDD / accountSize * 100) : 0;
  const risk1pct = hasAcct ? accountSize * 0.01 : 0;

  // Banner stats
  $('acctBalance').textContent = hasAcct ? fmt(currentBalance) : '—';
  $('acctBalance').style.color = !hasAcct ? 'var(--muted2)' : currentBalance >= accountSize ? 'var(--green)' : 'var(--red)';
  $('acctReturn').textContent = hasAcct ? (returnPct>=0?'+':'')+returnPct.toFixed(2)+'%' : '—';
  $('acctReturn').style.color = !hasAcct ? 'var(--muted2)' : returnPct>=0 ? 'var(--green)' : 'var(--red)';
  $('acctDDpct').textContent = hasAcct && m.maxDD>0 ? '-'+ddPct.toFixed(2)+'%' : '—';
  $('acctRiskAmt').textContent = hasAcct ? fmt(risk1pct) : '—';

  // Progress bar
  if(hasAcct){
    $('acctProgressWrap').style.display='block';
    const pct = Math.max(0, Math.min(200, (currentBalance/accountSize)*100));
    const fill = $('acctProgressFill');
    fill.style.width = Math.min(pct,100)+'%';
    fill.style.background = returnPct>=0 ? 'linear-gradient(90deg,var(--accent),var(--green))' : 'linear-gradient(90deg,var(--red),#ff8a65)';
    $('acctProgressLbl').textContent = returnPct.toFixed(2)+'%';
  } else {
    $('acctProgressWrap').style.display='none';
  }

  // Extra metric cards
  $('mcReturnCard').style.display = hasAcct ? '' : 'none';
  $('mcDDCard').style.display = hasAcct ? '' : 'none';
  if(hasAcct){
    $('mReturn').textContent = (returnPct>=0?'+':'')+returnPct.toFixed(2)+'%';
    $('mReturn').className = 'mc-value '+(returnPct>=0?'pos':'neg');
    $('mReturnSub').textContent = `Balance: ${fmt(currentBalance)}`;
    $('mDDpct').textContent = '-'+ddPct.toFixed(2)+'%';
    $('mDDpctSub').textContent = `$${m.maxDD.toFixed(2)} drawdown`;
  }

  drawCharts();
}

/* ==================== CHARTS ==================== */
function destroyChart(name){
  if(charts[name]){charts[name].destroy();delete charts[name];}
}

const chartOpts = {
  responsive:true, maintainAspectRatio:false,
  plugins:{legend:{labels:{color:'#9ca3af',font:{size:10,family:"'DM Mono',monospace"}}}},
  scales:{
    x:{ticks:{color:'#6b7280',font:{size:10}},grid:{color:'rgba(255,255,255,0.04)'}},
    y:{ticks:{color:'#6b7280',font:{size:10}},grid:{color:'rgba(255,255,255,0.04)'}}
  }
};

function drawCharts(){
  const sorted = [...trades].sort((a,b)=>new Date(a.date)-new Date(b.date));

  // EQUITY CURVE
  destroyChart('equity');
  let cum=0;
  const eqLabels = sorted.map(t=>t.date);
  const eqData = sorted.map(t=>{cum+=t.pnl;return cum;});
  if($('equityChart')){
    charts.equity = new Chart($('equityChart'),{
      type:'line',
      data:{labels:eqLabels,datasets:[{label:'Cumulative P&L',data:eqData,borderColor:'#6c63ff',backgroundColor:'rgba(108,99,255,0.1)',fill:true,tension:.3,pointRadius:2,pointHoverRadius:5}]},
      options:chartOpts
    });
  }

  // WIN/LOSS PIE
  destroyChart('wl');
  const m = computeMetrics();
  if($('wlChart')){
    charts.wl = new Chart($('wlChart'),{
      type:'doughnut',
      data:{labels:['Wins','Losses','BE'],datasets:[{data:[m.wins,m.losses,m.total-m.wins-m.losses],backgroundColor:['#10d98a','#ff4d6d','#9ca3af'],borderColor:'#0a0c0f',borderWidth:2}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:'#9ca3af',font:{size:10}}}}}
    });
  }

  // LONG VS SHORT
  destroyChart('ls');
  const longs = trades.filter(t=>t.dir==='Long');
  const shorts = trades.filter(t=>t.dir==='Short');
  const lWins = longs.filter(t=>t.pnl>0).length;
  const sWins = shorts.filter(t=>t.pnl>0).length;
  if($('lsChart')){
    charts.ls = new Chart($('lsChart'),{
      type:'bar',
      data:{labels:['Long','Short'],datasets:[
        {label:'Wins',data:[lWins,sWins],backgroundColor:'#10d98a'},
        {label:'Losses',data:[longs.length-lWins,shorts.length-sWins],backgroundColor:'#ff4d6d'}
      ]},
      options:chartOpts
    });
  }

  // SESSION PERFORMANCE
  destroyChart('session');
  const sessMap = {};
  trades.forEach(t=>{sessMap[t.session]=(sessMap[t.session]||0)+t.pnl;});
  if($('sessionChart')){
    charts.session = new Chart($('sessionChart'),{
      type:'bar',
      data:{labels:Object.keys(sessMap),datasets:[{label:'P&L',data:Object.values(sessMap),backgroundColor:Object.values(sessMap).map(v=>v>=0?'#10d98a':'#ff4d6d')}]},
      options:chartOpts
    });
  }

  // DOW
  destroyChart('dow');
  const dowMap = {Monday:0,Tuesday:0,Wednesday:0,Thursday:0,Friday:0};
  trades.forEach(t=>{if(dowMap[t.day]!==undefined)dowMap[t.day]+=t.pnl;});
  if($('dowChart')){
    charts.dow = new Chart($('dowChart'),{
      type:'bar',
      data:{labels:Object.keys(dowMap),datasets:[{label:'P&L',data:Object.values(dowMap),backgroundColor:Object.values(dowMap).map(v=>v>=0?'#6c63ff':'#ff4d6d')}]},
      options:chartOpts
    });
  }
}

/* ==================== TRADES TABLE ==================== */
function renderTrades(){
  const search = $('searchTrades').value.toLowerCase();
  const dir = $('filterDir').value;
  const out = $('filterOutcome').value;
  const sess = $('filterSession').value;
  const filtered = trades.filter(t=>{
    if(search && !((t.notes||'').toLowerCase().includes(search) || (t.instrument||'').toLowerCase().includes(search))) return false;
    if(dir && t.dir!==dir) return false;
    if(out && t.outcome!==out) return false;
    if(sess && t.session!==sess) return false;
    return true;
  });
  const tbody = $('tradeBody');
  tbody.innerHTML = filtered.map(t=>{
    const pnlCls = t.pnl>0?'pnl-pos':(t.pnl<0?'pnl-neg':'');
    const dirCls = t.dir==='Long'?'long':'short';
    const outCls = t.outcome==='TP'?'tp':(t.outcome==='SL'?'sl':(t.outcome==='Trailing stop'?'trail':'be'));
    const score = parseInt(t.score)||0;
    const pips = Array.from({length:5},(_,i)=>`<div class="score-pip ${i<score?'filled':''}"></div>`).join('');
    return `<tr onclick="openModal(${t.num})">
      <td>${t.num}</td><td>${t.date}</td><td>${t.day||''}</td>
      <td>${t.instrument||''}</td><td>${t.session||''}</td>
      <td>${t.time||''}</td><td>${t.size||''}</td>
      <td>${t.rr||''}</td><td>${t.duration||''}</td>
      <td><span class="pill ${dirCls}">${t.dir||''}</span></td>
      <td><span class="pill ${outCls}">${t.outcome||''}</span></td>
      <td class="${pnlCls}">${fmt(t.pnl)}</td>
      <td><div class="score-bar">${pips}</div></td>
      <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;color:var(--muted2)">${(t.notes||'').slice(0,40)}</td>
    </tr>`;
  }).join('');
}

