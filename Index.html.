const GLOSSARY = [
  {term:'P&L',abbr:'Profit and Loss',desc:'The realized profit or loss from a closed position. Sum of all wins minus losses.'},
  {term:'Net P&L',abbr:'Net Profit and Loss',desc:'Total P&L after deducting commissions, fees and slippage.'},
  {term:'Win Rate',abbr:'WR %',desc:'Percentage of trades closed profitably. Wins / Total Trades × 100.'},
  {term:'Profit Factor',abbr:'PF',desc:'Gross Profit / Gross Loss. PF > 1 = profitable. PF > 2 = excellent system.'},
  {term:'Risk-Reward Ratio',abbr:'R:R',desc:'Expected reward divided by risk. 1:2 means risking $1 to make $2.'},
  {term:'Expectancy',abbr:'E',desc:'Average $ outcome per trade. (Win% × AvgWin) − (Loss% × AvgLoss).'},
  {term:'Max Drawdown',abbr:'MDD',desc:'Largest peak-to-trough decline in account equity. Critical risk metric.'},
  {term:'Sharpe Ratio',abbr:'SR',desc:'Risk-adjusted return. (Mean return − Risk-free rate) / Std deviation.'},
  {term:'Recovery Factor',abbr:'RF',desc:'Net Profit / Max Drawdown. Measures how fast strategy recovers losses.'},
  {term:'Kelly Criterion',abbr:'Kelly %',desc:'Optimal position size formula. K = W − (1−W)/R where W=win rate, R=R:R.'},
  {term:'Take Profit',abbr:'TP',desc:'Pre-set price level to automatically close a winning trade.'},
  {term:'Stop Loss',abbr:'SL',desc:'Pre-set price level to automatically close a losing trade and limit risk.'},
  {term:'Break-Even',abbr:'BE',desc:'Closing trade at entry price (zero P&L) — typically by moving SL to entry.'},
  {term:'Trailing Stop',abbr:'TS',desc:'Dynamic SL that moves with price to lock in profits as trade goes favorable.'},
  {term:'Market Structure Shift',abbr:'MSS',desc:'A break of recent swing high/low indicating trend change. Core ICT concept.'},
  {term:'Fair Value Gap',abbr:'FVG',desc:'Imbalance / 3-candle gap where price is likely to retrace and fill.'},
  {term:'Order Block',abbr:'OB',desc:'The last opposing candle before a strong move — institutional footprint.'},
  {term:'Liquidity Sweep',abbr:'LIQ Sweep',desc:'Price moves through obvious stop-loss zones to grab liquidity then reverses.'},
